# Maintainer: Oddur Sigurdsson <oddurs@gmail.com>
#
# Generated by scripts/package-manifests; edit that, not this.
#
# The binary package. `fontina` beside it builds from source for anyone who would rather
# compile; this one installs the release archive, which is static musl and so has no glibc
# floor to trip over.
pkgname=fontina-bin
pkgver=0.1.1
pkgrel=1
pkgdesc='Lightweight, cross-platform font manager for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/oddurs/fontina'
license=('GPL-3.0-or-later')
provides=('fontina')
conflicts=('fontina')
optdepends=('fontconfig: so other programs see a font the moment it is activated')

source_x86_64=("fontina-0.1.1-x86_64.tar.gz::$url/releases/download/v0.1.1/fontina-v0.1.1-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("fontina-0.1.1-aarch64.tar.gz::$url/releases/download/v0.1.1/fontina-v0.1.1-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('2d3e3f1fdccd0e06fdb1fe535e29f707516443786e602ca2d852ae54e5c7a297')
sha256sums_aarch64=('4852fd307a651f1857bff2ec6639c5b789434f46d5da5f1bdf03e567a08e6517')

package() {
  local _dir
  case "$CARCH" in
    x86_64) _dir="fontina-v0.1.1-x86_64-unknown-linux-musl" ;;
    aarch64) _dir="fontina-v0.1.1-aarch64-unknown-linux-musl" ;;
  esac
  cd "$srcdir/$_dir"

  install -Dm755 fontina "$pkgdir/usr/bin/fontina"
  install -Dm644 completions/fontina.bash \
    "$pkgdir/usr/share/bash-completion/completions/fontina"
  install -Dm644 completions/_fontina "$pkgdir/usr/share/zsh/site-functions/_fontina"
  install -Dm644 completions/fontina.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/fontina.fish"
  for page in man/*.1; do
    install -Dm644 "$page" "$pkgdir/usr/share/man/man1/$(basename "$page")"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 fontina.texi "$pkgdir/usr/share/doc/$pkgname/fontina.texi"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
