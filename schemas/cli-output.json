{
  "$defs": {
    "ActivationRecord": {
      "properties": {
        "activated_at": {
          "format": "int64",
          "type": "integer"
        },
        "face": {
          "$ref": "#/$defs/FaceSummary"
        },
        "installed_path": {
          "description": "Where `install` put the copy, for `uninstall`.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ActivationState"
        }
      },
      "required": [
        "face",
        "state",
        "activated_at"
      ],
      "type": "object"
    },
    "ActivationState": {
      "description": "How a face was made available to the OS through fontina.",
      "oneOf": [
        {
          "const": "session",
          "description": "Registered until logout or reboot.",
          "type": "string"
        },
        {
          "const": "user",
          "description": "Registered persistently for the current user, in place.",
          "type": "string"
        },
        {
          "const": "installed",
          "description": "Copied (or linked) into the per-user font directory.",
          "type": "string"
        }
      ]
    },
    "AgentInstalled": {
      "description": "What `agent install --json` prints.",
      "properties": {
        "activate_with": {
          "description": "The command that starts it now rather than at the next login, if one is needed.",
          "type": [
            "string",
            "null"
          ]
        },
        "installed": {
          "type": "boolean"
        },
        "kind": {
          "description": "The mechanism, for a human: `systemd user unit`, `LaunchAgent`, `Startup folder`.",
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "installed",
        "path",
        "kind"
      ],
      "type": "object"
    },
    "AgentRemoved": {
      "description": "What `agent uninstall --json` prints.",
      "properties": {
        "deactivate_with": {
          "description": "The command that undoes the enablement, which deleting the file does not.",
          "type": [
            "string",
            "null"
          ]
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "removed"
      ],
      "type": "object"
    },
    "AgentStatus": {
      "description": "What `agent status --json` prints.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "installed": {
          "type": "boolean"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "installed",
        "enabled"
      ],
      "type": "object"
    },
    "BlockCoverage": {
      "description": "One Unicode block and the codepoints a face covers within it.",
      "properties": {
        "block": {
          "type": "string"
        },
        "block_size": {
          "description": "Size of the block, for a coverage ratio.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "codepoints": {
          "description": "Codepoints in the block that the face maps.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "block",
        "start",
        "end",
        "codepoints",
        "block_size"
      ],
      "type": "object"
    },
    "BundleReport": {
      "description": "What writing a bundle did.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dir": {
          "type": "string"
        },
        "faces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "description": "Font files copied. Fewer than `faces` when one file holds several of them.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dir",
        "faces",
        "files",
        "bytes"
      ],
      "type": "object"
    },
    "CheckReport": {
      "properties": {
        "errors": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "family": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "subfamily": {
          "type": "string"
        },
        "warnings": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "index",
        "family",
        "subfamily",
        "findings",
        "errors",
        "warnings"
      ],
      "type": "object"
    },
    "CollectionExport": {
      "description": "A collection as written by `collection export`; `schemas/collection.json`.",
      "properties": {
        "exported_at": {
          "description": "RFC 3339.",
          "type": "string"
        },
        "faces": {
          "items": {
            "$ref": "#/$defs/CollectionFace"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "relative_paths": {
          "description": "True when every `CollectionFace::path` is relative to the directory holding this\nfile, which is how a bundle is written. Absent means absolute, as every export\nbefore bundles was.\n\nThe flag is additive and `SCHEMA_VERSION` does not move for it. An older fontina\nreading a bundle ignores it and treats the relative paths as absolute, which\ncosts nothing in practice: the path is the *last* thing `match_collection_face`\ntries, after the identity hash and the PostScript name, and those do not depend\non where the file lives.",
          "type": "boolean"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "name",
        "exported_at",
        "faces"
      ],
      "type": "object"
    },
    "CollectionFace": {
      "description": "One face in an exported collection. On import, faces are matched by identity hash,\nthen PostScript name, then path and index, so a collection survives re-encoding the\nfont (TTF to WOFF2) or moving it.",
      "properties": {
        "blake3": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "identity_hash": {
          "type": "string"
        },
        "index": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "postscript_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "subfamily": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "family",
        "subfamily",
        "identity_hash",
        "blake3",
        "path"
      ],
      "type": "object"
    },
    "CollectionInfo": {
      "properties": {
        "created_at": {
          "description": "Seconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "faces",
        "created_at"
      ],
      "type": "object"
    },
    "ConfigReport": {
      "description": "What `config --json` prints: the file, whether it is there, and every setting with\nwhere its value came from.",
      "properties": {
        "found": {
          "description": "False when there is no file yet, which is not an error.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "settings": {
          "items": {
            "$ref": "#/$defs/Setting"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "found",
        "settings"
      ],
      "type": "object"
    },
    "Conflict": {
      "description": "A face that would clash with the one being activated.",
      "properties": {
        "face": {
          "$ref": "#/$defs/FaceSummary"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "face",
        "reason"
      ],
      "type": "object"
    },
    "DuplicateGroup": {
      "properties": {
        "faces": {
          "items": {
            "$ref": "#/$defs/FaceSummary"
          },
          "type": "array"
        },
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "key",
        "faces"
      ],
      "type": "object"
    },
    "EmbeddingLevel": {
      "enum": [
        "installable",
        "restricted_license",
        "preview_and_print",
        "editable"
      ],
      "type": "string"
    },
    "EmbeddingRights": {
      "description": "Decoded `OS/2.fsType` embedding permissions.",
      "properties": {
        "bitmap_only": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/EmbeddingLevel"
        },
        "no_subsetting": {
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "no_subsetting",
        "bitmap_only"
      ],
      "type": "object"
    },
    "FaceSummary": {
      "description": "Compact per-face row used by listings.",
      "properties": {
        "activation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActivationState"
            },
            {
              "type": "null"
            }
          ],
          "description": "Activation state recorded by fontina, if any."
        },
        "color": {
          "type": "boolean"
        },
        "container": {
          "type": "string"
        },
        "designer": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": "string"
        },
        "freedom": {
          "$ref": "#/$defs/Freedom",
          "default": "unstated",
          "description": "Whether `license` grants the four freedoms. Derived on read, never stored."
        },
        "glyph_count": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "italic": {
          "type": "boolean"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "monospace": {
          "default": false,
          "description": "What `post.isFixedPitch` says. Reported, never second-guessed: a font whose\nadvance widths contradict its own flag is a health check, not a filter that\nquietly disagrees with the file.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "postscript_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scripts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subfamily": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "variable": {
          "type": "boolean"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "format": "float",
          "type": "number"
        },
        "weight_range": {
          "description": "The weights this face can be set to, when a `wght` axis lets it be set at all.\n\nAbsent for a face that is only the one weight `weight` names, so the shape of a\nstatic face's JSON is exactly what it was, and presence is itself the answer to\n\"does this reach further than it says\".",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "width": {
          "format": "float",
          "type": "number"
        },
        "width_range": {
          "description": "The same, in percent, over `wdth`.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "index",
        "family",
        "subfamily",
        "weight",
        "width",
        "italic",
        "variable",
        "color",
        "glyph_count",
        "scripts",
        "container"
      ],
      "type": "object"
    },
    "FacetCount": {
      "properties": {
        "count": {
          "format": "int64",
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "count"
      ],
      "type": "object"
    },
    "Facets": {
      "description": "Counts of faces per facet value, for the faces matching a filter.",
      "properties": {
        "activation": {
          "description": "`session`, `user`, `installed`, or `none`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "collection": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "color": {
          "format": "int64",
          "type": "integer"
        },
        "container": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "families": {
          "format": "int64",
          "type": "integer"
        },
        "freedom": {
          "description": "`free`, `nonfree`, `unknown` or `unstated`, derived from the license.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "language": {
          "description": "Languages the matched faces claim, most-claimed first. The value carries which\nkind of claim it is, because the two are different questions: `TRK` is a shaping\nrule, `tr` is a name record.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "license": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "script": {
          "description": "ISO 15924 script codes.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "source": {
          "description": "Registered source directories the faces live under.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "spacing": {
          "description": "`monospace` or `proportional`, from `post.isFixedPitch`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "style": {
          "description": "`upright` or `italic`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "tag": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "variable": {
          "format": "int64",
          "type": "integer"
        },
        "vendor": {
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "weight": {
          "description": "CSS weight buckets, `100`..`900`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        },
        "width": {
          "description": "Width buckets as percentages, `50`..`200`.",
          "items": {
            "$ref": "#/$defs/FacetCount"
          },
          "type": "array"
        }
      },
      "required": [
        "faces",
        "families",
        "weight",
        "width",
        "style",
        "variable",
        "color",
        "container",
        "script",
        "language",
        "spacing",
        "license",
        "freedom",
        "vendor",
        "tag",
        "collection",
        "activation",
        "source"
      ],
      "type": "object"
    },
    "Family": {
      "description": "Faces grouped by typographic family name.",
      "properties": {
        "active": {
          "description": "Faces with an activation record.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "color": {
          "type": "boolean"
        },
        "containers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "designer": {
          "type": [
            "string",
            "null"
          ]
        },
        "faces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ids": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "italic": {
          "type": "boolean"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "representative": {
          "description": "The face to show for the family: upright, closest to weight 400 and width 100.",
          "format": "int64",
          "type": "integer"
        },
        "scripts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "variable": {
          "type": "boolean"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "weights": {
          "description": "Lowest and highest weight in the family.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "widths": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "name",
        "faces",
        "ids",
        "representative",
        "variable",
        "color",
        "italic",
        "weights",
        "widths",
        "scripts",
        "containers",
        "active"
      ],
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "description": "Stable identifier, `area/check`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "id",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "Freedom": {
      "description": "Whether a license grants the four freedoms.",
      "oneOf": [
        {
          "const": "free",
          "description": "The license grants all four freedoms.",
          "type": "string"
        },
        {
          "const": "nonfree",
          "description": "The license withholds at least one of them.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A license is stated, but it is not one that is known to be free.",
          "type": "string"
        },
        {
          "const": "unstated",
          "description": "The font carries no license information at all. No permission is stated, so in\nlaw none is granted, however the font was meant to be shared.",
          "type": "string"
        }
      ]
    },
    "ImportReport": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "matched": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing": {
          "description": "Faces in the file that are not in this index.",
          "items": {
            "$ref": "#/$defs/CollectionFace"
          },
          "type": "array"
        },
        "tags_applied": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "collection",
        "matched",
        "missing",
        "tags_applied"
      ],
      "type": "object"
    },
    "LicenseRow": {
      "properties": {
        "copyright": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmbeddingRights"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "type": "string"
        },
        "freedom": {
          "$ref": "#/$defs/Freedom"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "description": "Why `freedom` is what it is, in one line.",
          "type": "string"
        },
        "reserved_font_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spdx": {
          "type": [
            "string",
            "null"
          ]
        },
        "subfamily": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "family",
        "subfamily",
        "path",
        "freedom",
        "reason",
        "reserved_font_names"
      ],
      "type": "object"
    },
    "Paths": {
      "description": "A list of paths, printed as a bare array so it pipes straight back into `--stdin`.\n\nThe newtype exists to give the array a name in `schemas/cli-output.json`: a type\nprinted with `--json` has to be described there, and `Vec<PathBuf>` has no name to\ndescribe. `transparent` keeps the JSON exactly what it was.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "Related": {
      "description": "One candidate from [`Index::related`], with the numbers that say what the overlap\nmeans.\n\nThe score is printed rather than thresholded away, and the metrics stand beside it,\nbecause \"covers the same characters\" is not the same as \"is the same design\". High\noverlap with identical metrics is a variant of one typeface; high overlap with\ndifferent metrics is two fonts that happen to serve the same languages. The reader\ndraws that line, the way `freedom` reports a verdict and its reason rather than\nfiltering silently.",
      "properties": {
        "face": {
          "$ref": "#/$defs/FaceSummary"
        },
        "metrics_agree": {
          "description": "True when units per em, ascender, descender and fixed pitch all agree with the\ntarget — the four numbers that decide whether identical coverage means identical\ndesign.",
          "type": "boolean"
        },
        "overlap": {
          "description": "Jaccard similarity of the two codepoint sets: `|A ∩ B| / |A ∪ B|`, 0.0 to 1.0.",
          "format": "double",
          "type": "number"
        },
        "shared": {
          "description": "Codepoints both cover.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "union": {
          "description": "Codepoints either covers.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "face",
        "overlap",
        "shared",
        "union",
        "metrics_agree"
      ],
      "type": "object"
    },
    "RestoreReport": {
      "properties": {
        "failed": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "reinstalled": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "restored": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "restored",
        "reinstalled",
        "failed"
      ],
      "type": "object"
    },
    "ScanFailure": {
      "properties": {
        "error": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "error"
      ],
      "type": "object"
    },
    "ScanReport": {
      "properties": {
        "candidates": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "faces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "items": {
            "$ref": "#/$defs/ScanFailure"
          },
          "type": "array"
        },
        "parsed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "description": "Files that are fonts in a format this program does not read.\n\nA scan used to say nothing about these, because the walk filters on the file\nextension before it opens anything, so a Type 1 or a bitmap font was never\nconsidered and never mentioned. Three fonts in a directory reported\n`1 candidates … 0 failed`, and for a font manager that is the worst answer\navailable: a parse failure can be acted on, but a file that was never looked at\nleaves someone believing their library is indexed.",
          "items": {
            "$ref": "#/$defs/SkippedFile"
          },
          "type": "array"
        },
        "unchanged": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "candidates",
        "parsed",
        "faces",
        "unchanged",
        "removed",
        "failed"
      ],
      "type": "object"
    },
    "Setting": {
      "description": "One resolved setting, for `fontina config`.",
      "properties": {
        "key": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SettingSource"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "source"
      ],
      "type": "object"
    },
    "SettingSource": {
      "description": "Where a value came from.\n\n`SettingSource` rather than `Source` because `schemas/cli-output.json` names every\ntype it defines, and the core already has a `Source`: the directories a library is\nscanned from, which `fontina source list` prints.",
      "oneOf": [
        {
          "const": "default",
          "description": "Compiled in.",
          "type": "string"
        },
        {
          "const": "file",
          "description": "The configuration file.",
          "type": "string"
        },
        {
          "const": "environment",
          "description": "An environment variable.",
          "type": "string"
        },
        {
          "const": "flag",
          "description": "An argument on this command line.",
          "type": "string"
        }
      ]
    },
    "Severity": {
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "SkippedFile": {
      "description": "A font this program will not read, and what it is.",
      "properties": {
        "format": {
          "description": "The format, as a name a person would recognise.",
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "format"
      ],
      "type": "object"
    },
    "Source": {
      "properties": {
        "added_at": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "path": {
          "type": "string"
        },
        "watch": {
          "description": "Followed by `fontina watch`.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "watch",
        "kind",
        "added_at"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "Why a directory is in the index.",
      "oneOf": [
        {
          "const": "user",
          "description": "Added by the user (`scan <dir>`, `source add`).",
          "type": "string"
        },
        {
          "const": "system",
          "description": "An operating-system font directory (`scan --system`).",
          "type": "string"
        }
      ]
    },
    "Stats": {
      "properties": {
        "activations": {
          "format": "int64",
          "type": "integer"
        },
        "collections": {
          "format": "int64",
          "type": "integer"
        },
        "color_faces": {
          "format": "int64",
          "type": "integer"
        },
        "db_path": {
          "type": "string"
        },
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "failed_files": {
          "format": "int64",
          "type": "integer"
        },
        "families": {
          "format": "int64",
          "type": "integer"
        },
        "files": {
          "format": "int64",
          "type": "integer"
        },
        "sources": {
          "format": "int64",
          "type": "integer"
        },
        "tags": {
          "format": "int64",
          "type": "integer"
        },
        "variable_faces": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "files",
        "faces",
        "families",
        "variable_faces",
        "color_faces",
        "failed_files",
        "tags",
        "collections",
        "sources",
        "activations",
        "db_path"
      ],
      "type": "object"
    },
    "SystemFontDir": {
      "properties": {
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "user_writable": {
          "description": "True for the directory a per-user install writes to.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "user_writable",
        "description"
      ],
      "type": "object"
    },
    "TagInfo": {
      "properties": {
        "faces": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "faces"
      ],
      "type": "object"
    },
    "TagSyncChange": {
      "properties": {
        "added": {
          "description": "Tags the destination gained.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "removed": {
          "description": "Tags the destination lost. Sync mirrors rather than merges: two tag sets with no\ncommon ancestor cannot tell a deletion from an addition, so the direction says\nwhich side is right and the other is made to match it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "added",
        "removed"
      ],
      "type": "object"
    },
    "TagSyncReport": {
      "description": "What `fontina tag sync` did, or would do.\n\nThe counts are per *file*, not per face: a tag lives on a file, and a TrueType\ncollection holds several faces in one.",
      "properties": {
        "changed": {
          "description": "Files whose tags differed. With `dry_run`, files that would have been changed.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "changes": {
          "description": "One entry per file that differed.",
          "items": {
            "$ref": "#/$defs/TagSyncChange"
          },
          "type": "array"
        },
        "direction": {
          "description": "`to-files` or `from-files`.",
          "type": "string"
        },
        "dry_run": {
          "description": "Nothing was written.",
          "type": "boolean"
        },
        "files": {
          "description": "Files considered.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "description": "Whatever could not be carried across, and why. Never fatal: one font in a system\ndirectory, or on a filesystem without extended attributes, should not stop the\nother three hundred.",
          "items": {
            "$ref": "#/$defs/TagSyncSkip"
          },
          "type": "array"
        }
      },
      "required": [
        "direction",
        "files",
        "changed",
        "dry_run",
        "changes",
        "skipped"
      ],
      "type": "object"
    },
    "TagSyncSkip": {
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "type": "object"
    },
    "WatchEvent": {
      "description": "One batch of changes applied to the index.",
      "properties": {
        "paths": {
          "description": "Files re-parsed or dropped, plus directories rescanned.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report": {
          "$ref": "#/$defs/ScanReport"
        }
      },
      "required": [
        "paths",
        "report"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Every type `fontina --json` prints, one definition each.",
  "title": "fontina CLI output"
}
