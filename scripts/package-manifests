#!/usr/bin/env python3
"""Write the package manifests in packaging/ from a tagged release.

    scripts/package-manifests v0.1.2      # fetch the release's checksums and rewrite
    scripts/package-manifests --check     # offline: are the checked-in ones consistent?

The manifests are generated, not hand-edited, for the reason `schemas/` is: every one of
them repeats the version and a checksum, and a set kept by hand is a version behind by the
second release. They are checked in so they can be read and reviewed, and this file is
where a change to any of them belongs.

Checksums come from the `.sha256` files the release already publishes beside each archive,
so nothing is re-hashed here and there is no second source to disagree with.
"""

import argparse
import pathlib
import re
import subprocess
import sys
import tempfile

REPO = "oddurs/fontina"
ROOT = pathlib.Path(__file__).resolve().parent.parent
PACKAGING = ROOT / "packaging"

# target -> the archive suffix the release publishes for it
TARGETS = {
    "darwin_arm": ("aarch64-apple-darwin", "tar.gz"),
    "darwin_x86": ("x86_64-apple-darwin", "tar.gz"),
    "linux_arm": ("aarch64-unknown-linux-musl", "tar.gz"),
    "linux_x86": ("x86_64-unknown-linux-musl", "tar.gz"),
    "windows_x86": ("x86_64-pc-windows-msvc", "zip"),
}

DOWNLOAD = f"https://github.com/{REPO}/releases/download"
GENERATED = "Generated by scripts/package-manifests; edit that, not this."


def archive(tag: str, key: str) -> str:
    target, ext = TARGETS[key]
    return f"fontina-{tag}-{target}.{ext}"


def checksums(tag: str) -> dict[str, str]:
    """The published sha256 of each archive, read from the release's own sidecars."""
    with tempfile.TemporaryDirectory() as work:
        subprocess.run(
            ["gh", "release", "download", tag, "--repo", REPO,
             "--pattern", "*.sha256", "--dir", work],
            check=True, stdout=subprocess.DEVNULL,
        )
        out = {}
        for key in TARGETS:
            name = archive(tag, key)
            path = pathlib.Path(work) / f"{name}.sha256"
            if not path.exists():
                sys.exit(f"error: {tag} published no checksum for {name}")
            # `<hash>  <name>`, or `<hash> *<name>` — the Windows runner writes it in
            # binary mode. Taking the first field covers both; anything else is a
            # malformed sidecar and a manifest with an empty hash installs nothing.
            digest = path.read_text().split()[0]
            if not re.fullmatch(r"[0-9a-f]{64}", digest):
                sys.exit(f"error: {name}.sha256 does not hold a sha256: {digest!r}")
            out[key] = digest
        return out


def homebrew(tag: str, version: str, sha: dict[str, str]) -> str:
    def block(key: str) -> str:
        return (
            f'      url "{DOWNLOAD}/{tag}/{archive(tag, key)}"\n'
            f'      sha256 "{sha[key]}"\n'
        )

    return f'''# Homebrew formula for fontina.
#
# {GENERATED}
# The release workflow copies it into the tap at {REPO.split("/")[0]}/homebrew-fontina,
# which is what `brew tap {REPO.split("/")[0]}/fontina && brew install fontina` reads.
#
# A binary formula, not a source one: the release already builds and attests four platform
# archives, and asking every installer to compile the workspace again would spend minutes
# arriving at the same bytes.
class Fontina < Formula
  desc "Lightweight, cross-platform font manager for the terminal"
  homepage "https://github.com/{REPO}"
  version "{version}"
  license "GPL-3.0-or-later"

  on_macos do
    on_arm do
{block("darwin_arm")}    end
    on_intel do
{block("darwin_x86")}    end
  end

  on_linux do
    on_arm do
{block("linux_arm")}    end
    on_intel do
{block("linux_x86")}    end
  end

  def install
    bin.install "fontina"
    man1.install Dir["man/*.1"]
    bash_completion.install "completions/fontina.bash" => "fontina"
    zsh_completion.install "completions/_fontina"
    fish_completion.install "completions/fontina.fish"
    doc.install "README.md", "COPYING", "fontina.texi"
  end

  test do
    assert_match version.to_s, shell_output("#{{bin}}/fontina --version")

    # The index is fontina's only state and it lives where the OS says it should, so the
    # test points it somewhere disposable rather than writing to the tester's own.
    ENV["FONTINA_DB"] = testpath/"index.db"

    # A schema is the cheapest proof the binary is whole: it exercises the metadata model
    # and its serialisation without needing a font on disk.
    assert_match "FaceMetadata", shell_output("#{{bin}}/fontina schema face")

    # An empty index answers rather than failing, which is what a first run depends on.
    assert_match "no faces", shell_output("#{{bin}}/fontina list")
  end
end
'''


def scoop(tag: str, version: str, sha: dict[str, str]) -> str:
    name = archive(tag, "windows_x86")
    stem = name[: -len(".zip")]
    return f'''{{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "##": "{GENERATED}",
    "version": "{version}",
    "description": "Lightweight, cross-platform font manager for the terminal",
    "homepage": "https://github.com/{REPO}",
    "license": "GPL-3.0-or-later",
    "architecture": {{
        "64bit": {{
            "url": "{DOWNLOAD}/{tag}/{name}",
            "hash": "{sha["windows_x86"]}",
            "extract_dir": "{stem}"
        }}
    }},
    "bin": "fontina.exe",
    "notes": [
        "Completions: dot-source completions\\\\_fontina.ps1 from your PowerShell profile.",
        "The manual is fontina.texi in the install directory; `fontina --help` covers the commands.",
        "fontina never writes to a system font directory and makes no network calls."
    ],
    "checkver": {{
        "github": "https://github.com/{REPO}"
    }},
    "autoupdate": {{
        "architecture": {{
            "64bit": {{
                "url": "{DOWNLOAD}/v$version/fontina-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "fontina-v$version-x86_64-pc-windows-msvc"
            }}
        }},
        "hash": {{
            "url": "$url.sha256"
        }}
    }}
}}
'''


def winget_version(_tag: str, version: str, _sha: dict[str, str]) -> str:
    return f"""# {GENERATED}
PackageIdentifier: oddurs.fontina
PackageVersion: {version}
DefaultLocale: en-US
ManifestType: version
ManifestVersion: 1.6.0
"""


def winget_installer(tag: str, version: str, sha: dict[str, str]) -> str:
    name = archive(tag, "windows_x86")
    stem = name[: -len(".zip")]
    return f"""# {GENERATED}
#
# A zip holding a portable binary, which winget calls a nested portable installer: there
# is nothing to run and nothing to uninstall but the file itself. fontina writes only to
# its own per-user data directory and never to a system font directory, so there is no
# installer to write and none to trust.
PackageIdentifier: oddurs.fontina
PackageVersion: {version}
InstallerType: zip
NestedInstallerType: portable
Installers:
  - Architecture: x64
    InstallerUrl: {DOWNLOAD}/{tag}/{name}
    InstallerSha256: {sha["windows_x86"].upper()}
    NestedInstallerFiles:
      - RelativeFilePath: {stem}\\fontina.exe
        PortableCommandAlias: fontina
ManifestType: installer
ManifestVersion: 1.6.0
"""


def winget_locale(tag: str, version: str, _sha: dict[str, str]) -> str:
    return f"""# {GENERATED}
PackageIdentifier: oddurs.fontina
PackageVersion: {version}
PackageLocale: en-US
Publisher: Oddur Sigurdsson
PublisherUrl: https://github.com/oddurs
PublisherSupportUrl: https://github.com/{REPO}/issues
PackageName: fontina
PackageUrl: https://github.com/{REPO}
License: GPL-3.0-or-later
LicenseUrl: https://github.com/{REPO}/blob/main/COPYING
Copyright: Copyright (C) 2026 Oddur Sigurdsson
ShortDescription: Lightweight, cross-platform font manager for the terminal
Description: |-
  fontina indexes the fonts you have, tells you what is in them, and makes them available
  to other programs, from the command line or a keyboard-driven browser.

  It reads a font with fontations, the parser Chrome and Skia use, and shapes previews
  with a HarfBuzz port, so complex scripts are correct rather than approximated. It
  reports each font's licence as an SPDX identifier and says plainly whether that licence
  grants you the four freedoms.

  Nothing leaves your machine: no network calls, no accounts, no telemetry. Nothing is
  written to a system font directory and nothing asks for elevation. Every export is JSON
  with a published schema, so your data stays readable without fontina.
Moniker: fontina
Tags:
  - cli
  - font
  - font-manager
  - fonts
  - opentype
  - terminal
  - truetype
  - typography
ReleaseNotesUrl: https://github.com/{REPO}/releases/tag/{tag}
Documentations:
  - DocumentLabel: Manual
    DocumentUrl: https://oddurs.github.io/fontina/docs/
ManifestType: defaultLocale
ManifestVersion: 1.6.0
"""


def aur_bin(tag: str, version: str, sha: dict[str, str]) -> str:
    return f"""# Maintainer: Oddur Sigurdsson <oddurs@gmail.com>
#
# {GENERATED}
#
# The binary package. `fontina` beside it builds from source for anyone who would rather
# compile; this one installs the release archive, which is static musl and so has no glibc
# floor to trip over.
pkgname=fontina-bin
pkgver={version}
pkgrel=1
pkgdesc='Lightweight, cross-platform font manager for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/{REPO}'
license=('GPL-3.0-or-later')
provides=('fontina')
conflicts=('fontina')
optdepends=('fontconfig: so other programs see a font the moment it is activated')

source_x86_64=("fontina-{version}-x86_64.tar.gz::$url/releases/download/{tag}/{archive(tag, "linux_x86")}")
source_aarch64=("fontina-{version}-aarch64.tar.gz::$url/releases/download/{tag}/{archive(tag, "linux_arm")}")
sha256sums_x86_64=('{sha["linux_x86"]}')
sha256sums_aarch64=('{sha["linux_arm"]}')

package() {{
  local _dir
  case "$CARCH" in
    x86_64) _dir="fontina-{tag}-x86_64-unknown-linux-musl" ;;
    aarch64) _dir="fontina-{tag}-aarch64-unknown-linux-musl" ;;
  esac
  cd "$srcdir/$_dir"

  install -Dm755 fontina "$pkgdir/usr/bin/fontina"
  install -Dm644 completions/fontina.bash \\
    "$pkgdir/usr/share/bash-completion/completions/fontina"
  install -Dm644 completions/_fontina "$pkgdir/usr/share/zsh/site-functions/_fontina"
  install -Dm644 completions/fontina.fish \\
    "$pkgdir/usr/share/fish/vendor_completions.d/fontina.fish"
  for page in man/*.1; do
    install -Dm644 "$page" "$pkgdir/usr/share/man/man1/$(basename "$page")"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 fontina.texi "$pkgdir/usr/share/doc/$pkgname/fontina.texi"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}}
"""


def aur_source(tag: str, version: str, _sha: dict[str, str]) -> str:
    return f"""# Maintainer: Oddur Sigurdsson <oddurs@gmail.com>
#
# {GENERATED}
#
# The source package. `fontina-bin` beside it installs the release archive; this one
# compiles, which is what Arch expects of a package that can be built from source and what
# anyone who would rather not trust a prebuilt binary will reach for.
pkgname=fontina
pkgver={version}
pkgrel=1
pkgdesc='Lightweight, cross-platform font manager for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/{REPO}'
license=('GPL-3.0-or-later')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('fontconfig: so other programs see a font the moment it is activated')
conflicts=('fontina-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/{tag}.tar.gz")
sha256sums=('SKIP')

prepare() {{
  cd "$pkgname-$pkgver"
  # Vendor now so build() needs no network, which is what makepkg expects and what
  # building in a clean chroot requires.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}}

build() {{
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --package fontina-cli
}}

check() {{
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace
}}

package() {{
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/fontina "$pkgdir/usr/bin/fontina"

  # Generated by the binary just built, so they cannot drift from its own --help.
  local _out="$srcdir/generated"
  mkdir -p "$_out/man"
  target/release/fontina completions bash > "$_out/fontina.bash"
  target/release/fontina completions zsh > "$_out/_fontina"
  target/release/fontina completions fish > "$_out/fontina.fish"
  target/release/fontina man --out-dir "$_out/man"

  install -Dm644 "$_out/fontina.bash" \\
    "$pkgdir/usr/share/bash-completion/completions/fontina"
  install -Dm644 "$_out/_fontina" "$pkgdir/usr/share/zsh/site-functions/_fontina"
  install -Dm644 "$_out/fontina.fish" \\
    "$pkgdir/usr/share/fish/vendor_completions.d/fontina.fish"
  for page in "$_out"/man/*.1; do
    install -Dm644 "$page" "$pkgdir/usr/share/man/man1/$(basename "$page")"
  done

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/fontina.texi "$pkgdir/usr/share/doc/$pkgname/fontina.texi"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}}
"""


FILES = [
    ("homebrew/fontina.rb", homebrew),
    ("scoop/fontina.json", scoop),
    ("winget/oddurs.fontina.yaml", winget_version),
    ("winget/oddurs.fontina.installer.yaml", winget_installer),
    ("winget/oddurs.fontina.locale.en-US.yaml", winget_locale),
    ("aur/fontina-bin/PKGBUILD", aur_bin),
    ("aur/fontina/PKGBUILD", aur_source),
]


def write(tag: str) -> None:
    version = tag.lstrip("v")
    sha = checksums(tag)
    for rel, fn in FILES:
        path = PACKAGING / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(fn(tag, version, sha), encoding="utf-8")
        print(f"  {path.relative_to(ROOT)}")
    print(f"manifests are at {version}")


def check() -> int:
    """Offline: do the checked-in manifests agree with each other?

    Not a substitute for regenerating — it cannot know the real checksums — but it catches
    the hand-edit that matters: a manifest left naming the previous version, which would
    install the previous version and say nothing.
    """
    problems = []
    versions, tags = set(), set()
    for rel, _ in FILES:
        path = PACKAGING / rel
        if not path.exists():
            problems.append(f"{rel} is missing")
            continue
        text = path.read_text(encoding="utf-8")
        if GENERATED not in text:
            problems.append(f"{rel} does not say it is generated")
        versions |= set(re.findall(r"(?m)^(?:\s*)(?:version \"|\"version\": \"|PackageVersion: |pkgver=)([0-9][^\"\s]*)", text))
        tags |= set(re.findall(r"fontina-(v[0-9][^-\s\"']*)-", text))
        for digest in re.findall(r"\b[0-9a-fA-F]{64}\b", text):
            if digest != digest.lower() and digest != digest.upper():
                problems.append(f"{rel}: {digest} is neither lower nor upper case")
    if len(versions) > 1:
        problems.append(f"the manifests name more than one version: {sorted(versions)}")
    if len(tags) > 1:
        problems.append(f"the archive URLs name more than one tag: {sorted(tags)}")
    if versions and tags and f"v{versions.pop()}" not in tags:
        problems.append("the version and the archive URLs disagree")
    for p in problems:
        print(f"error: {p}", file=sys.stderr)
    if not problems:
        print(f"the {len(FILES)} manifests agree with each other")
    return 1 if problems else 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("tag", nargs="?", help="the release tag, e.g. v0.1.2")
    ap.add_argument("--check", action="store_true", help="offline consistency check")
    args = ap.parse_args()
    if args.check:
        return check()
    if not args.tag:
        ap.error("give a tag, or --check")
    if not re.fullmatch(r"v[0-9][0-9A-Za-z.\-+]*", args.tag):
        ap.error(f"a tag looks like v0.1.2, not {args.tag!r}")
    write(args.tag)
    return check()


if __name__ == "__main__":
    sys.exit(main())
